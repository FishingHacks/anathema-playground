container [height: 1]
    hstack
        text [bold: true] state.name ": "
        if state.focused
            border [width: attributes.width, height: 1, sides: [], background: "black", foreground: "white"]
                expand [fill: " "]
                    zstack
                        text [bold: true] state.value
                        padding [left: state.position_x]
                            container [width: 1, height: 1, inverse: true]
        else
            border [width: attributes.width, height: 1, sides: [], background: "dark_grey", foreground: "black"]
                expand [fill: " "]
                    text state.value
