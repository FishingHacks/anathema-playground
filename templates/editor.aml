zstack
    border
        canvas [width: state.width || 1, height: state.height || 1, id: "editor"]
    padding [left: 3, right: 3]
        vstack
            hstack
                text "{ "
                    if state.focused
                        span [bold: THEME.bold_file_focused, foreground: THEME.fg_file_focused] state.file
                    else
                        span [bold: THEME.bold_file_unfocused, foreground: THEME.fg_file_unfocused] state.file
                    if state.dirty
                        span [bold: true] "*"
                text " | "
                //@input (submit->search) [width: state.width / 3]
                text " }"
            expand
            if state.focused
                text "{ "
                    span [bold: THEME.bold_keybind, foreground: THEME.fg_keybind] "Ctrl-R"
                    span ": Run"
                    span " | "
                    span [bold: THEME.bold_keybind, foreground: THEME.fg_keybind] "Ctrl-S"
                    span ": Save"
                    span " | "
                    span [bold: THEME.bold_keybind, foreground: THEME.fg_keybind] "Ctrl-C"
                    span ": Quit (does not save)"
                    span " | "
                    span [bold: THEME.bold_keybind, foreground: THEME.fg_keybind] "Ctrl-Space"
                    span ": Tab"
                    span " }"
            else
                text "{ "
                    span [bold: THEME.bold_keybind, foreground: THEME.fg_keybind] "Tab"
                    span ": Focus"
                    span " }"
